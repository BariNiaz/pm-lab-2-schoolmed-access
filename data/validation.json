{
  "_comment": "Правила проверки слоёв в data/processed для scripts/validate_data.py. Проверяются слои проекта SchoolMed Access (Уфа).",
  "crs": "EPSG:4326",
  "bbox": [55.6, 54.5, 56.3, 55.0],
  "max_file_mb": 10,
  "layers": {
    "boundary": {"geometry": ["Polygon", "MultiPolygon"], "min_count": 1},
    "districts": {"geometry": ["Polygon", "MultiPolygon"], "min_count": 7, "id": ["osm_type", "osm_id"], "required": ["name"]},
    "schools": {"geometry": ["Point"], "min_count": 100, "id": ["osm_type", "osm_id"], "required": ["amenity"]},
    "clinics": {"geometry": ["Point"], "min_count": 100, "id": ["osm_type", "osm_id"], "required": ["amenity"]}
  }
}
